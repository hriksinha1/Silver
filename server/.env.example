# Copy this file to server/.env. Never commit server/.env or share these secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=silveram
# Optional, only for `npm run db:setup`: a temporary user with dbAdmin on this database. Never used by the running API.
MONGODB_SETUP_URI=
SESSION_SECRET=<generate-a-random-secret-at-least-32-bytes>
OTP_PEPPER=<generate-a-different-random-secret-at-least-32-bytes>
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
ADMIN_EMAILS=
PRODUCT_IMAGE_HOSTS=

# Product/site images live in Cloudinary (never MongoDB); MongoDB keeps only publicId, size and alt text.
# Folders: <root>/<development|production>/products/<sku>/... and <root>/<env>/site/<area>/...
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=silveram
STORE_LIVE_CHECKOUT=false
RAZORPAY_ENABLED=false
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Configure a verified sender and an authenticated SMTP relay to send sign-in codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Silveram <no-reply@example.com>"

# Razorpay secrets are server-only. Keep RAZORPAY_ENABLED=false until the provider is integrated and tested.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
